# Kopiér til .env og udfyld. .env må aldrig committes.
# Datafordeleren: opret et IT-system i selvbetjeningen på datafordeler.dk og generér en API-nøgle.
DATAFORDELER_API_KEY=
# Dataforsyningen: opret gratis bruger på dataforsyningen.dk og lav et token.
DATAFORSYNINGEN_TOKEN=
# Kun til HTTP-tilstand (byg-mcp --http, fx bag Cloudflare Tunnel): hemmelig del af URL'en, mindst 32 tegn.
# Generér med: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
BYG_MCP_HTTP_TOKEN=
# Energistyrelsens EMOData (energimærker): brugernavn og adgangskode fås ved henvendelse til Energistyrelsen.
EMO_BRUGERNAVN=
EMO_ADGANGSKODE=
